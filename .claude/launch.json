{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "catalog",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 4176
    },
    {
      "name": "patterns",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "design:serve"
      ],
      "port": 4173
    },
    {
      "name": "app",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--filter",
        "@weave/app",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "app-fixture",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "WEAVE_ACCOUNT_FIXTURE=1",
        "bun",
        "run",
        "--filter",
        "@weave/app",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "app-preview",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--filter",
        "@weave/app",
        "preview"
      ],
      "port": 4174
    },
    {
      "name": "preview-prototype",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "SERVE_ROOT=docs/platform/prototype",
        "PORT=4198",
        "bun",
        "serve.mjs"
      ],
      "port": 4198
    }
  ]
}
