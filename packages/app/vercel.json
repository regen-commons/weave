{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "codex/matching-evaluation": false,
      "develop": false
    }
  },
  "framework": "vite",
  "installCommand": "bun install --frozen-lockfile --filter @weave/app",
  "buildCommand": "bun run --filter '@weave/*' build && bun run --filter '@weave/*' test",
  "outputDirectory": "dist",
  "functions": {
    "api/project-index-refresh.ts": { "maxDuration": 300 },
    "api/record-page.ts": { "includeFiles": "dist/{shell.html,index.html,share/records.json}" },
    "api/sitemap.ts": { "includeFiles": "dist/share/records.json" }
  },
  "crons": [
    { "path": "/api/project-index-refresh", "schedule": "0 4 * * *" }
  ],
  "rewrites": [
    { "source": "/funding/:id", "destination": "/api/record-page?kind=funding&id=:id" },
    { "source": "/initiatives/:id", "destination": "/api/record-page?kind=initiative&id=:id" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(sw.js|registerSW.js|manifest.webmanifest|index.html)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
