{
  "ci": {
    "collect": {
      "startServerCommand": "node e2e/serve.mjs 4800",
      "startServerReadyPattern": "served as Vercel serves it",
      "startServerReadyTimeout": 60000,
      "numberOfRuns": 3,
      "url": [
        "http://localhost:4800/",
        "http://localhost:4800/initiatives",
        "http://localhost:4800/funding",
        "http://localhost:4800/funding/local-nlnet",
        "http://localhost:4800/start/initiative",
        "http://localhost:4800/your-initiatives",
        "http://localhost:4800/settings"
      ],
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
            "categories:best-practices": ["error", { "minScore": 0.96, "aggregationMethod": "median-run" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2000, "aggregationMethod": "median-run" }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:4800/(funding(/[^/]+)?|initiatives)?$",
          "assertions": { "categories:seo": ["error", { "minScore": 1, "aggregationMethod": "median-run" }] }
        },
        { "matchingUrlPattern": "^http://localhost:4800/$", "assertions": { "categories:performance": ["error", { "minScore": 0.85, "aggregationMethod": "median-run" }] } },
        { "matchingUrlPattern": "/initiatives$", "assertions": { "categories:performance": ["error", { "minScore": 0.75, "aggregationMethod": "median-run" }] } },
        { "matchingUrlPattern": "/funding$", "assertions": { "categories:performance": ["error", { "minScore": 0.85, "aggregationMethod": "median-run" }] } },
        { "matchingUrlPattern": "/funding/local-nlnet$", "assertions": { "categories:performance": ["error", { "minScore": 0.85, "aggregationMethod": "median-run" }] } },
        { "matchingUrlPattern": "/start/initiative$", "assertions": { "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }] } },
        { "matchingUrlPattern": "/your-initiatives$", "assertions": { "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }] } },
        { "matchingUrlPattern": "/settings$", "assertions": { "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }] } }
      ]
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
